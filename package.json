{
  "name": "nodejs-backend-for-static-site",
  "version": "1.0.0",
  "description": "A Node.js backend for a static site with routing and basic authentication endpoints.",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.6",
    "dotenv": "16.4.5",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "passport": "0.7.0",
    "passport-azure-ad": "4.3.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.16",
    "@types/passport": "^1.0.16",
    "@types/passport-azure-ad": "^4.3.6",
    "nodemon": "3.1.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
